# Terraform with hardcoded region - should warn
variable "region_name" {
  description = "Region name"
  type        = string
}

resource "aws_vpc" "main" {
  cidr_block = "10.0.0.0/16"
  region     = "us-east-1"  # Hardcoded - should warn
}

data "aws_availability_zones" "available" {
  state = "available"
  # eu-west-1 is hardcoded - should warn
}

resource "aws_instance" "web" {
  ami           = "ami-12345678"
  instance_type = "t3.medium"
  # ap-south-1 hardcoded - should warn
}
