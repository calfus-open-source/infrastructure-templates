
resource "tls_private_key" "ssh_key_pk" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "ssh_key_pair" {
  key_name   = "${var.ssh_key_name}"
  public_key = tls_private_key.ssh_key_pk.public_key_openssh
}

resource "local_sensitive_file" "ssh_key_pem" {
  filename = pathexpand("~/.ssh/${var.ssh_key_name}.pem")
  file_permission = "600"
  directory_permission = "700"
  content = tls_private_key.ssh_key_pk.private_key_pem
}

resource "aws_s3_bucket" "env_files" {
  bucket = "${var.env_files_bucket_name}"
  tags = {
    "Name"           = var.env_files_bucket_name
    "product"        = var.project_name
    "environment"    = var.environment
    "role"           = "storage"
    "terraform"      = "true"
  }
}

resource "aws_s3_bucket_ownership_controls" "env_files_ownership" {
  bucket = aws_s3_bucket.env_files.id
  rule {
    object_ownership = "BucketOwnerPreferred"
  }
}

resource "aws_s3_bucket_acl" "env_files_acl" {
  depends_on = [aws_s3_bucket_ownership_controls.env_files_ownership]

  bucket = aws_s3_bucket.env_files.id
  acl    = "private"
}

resource "aws_s3_object" "ssh_key_upload" {
  bucket = aws_s3_bucket.env_files.id
  key    = "${var.ssh_key_name}.pem"
  content = tls_private_key.ssh_key_pk.private_key_pem
}

output "ssh_key_name" {
  value = aws_key_pair.ssh_key_pair.key_name
}
