
data "aws_ami" "bastion_host_ami" {
    most_recent = true

    owners = ["{{ bastion_host_ami_owner }}"]

    filter {
        name   = "name"
        values = ["{{ bastion_host_ami_name }}"]
    }

    filter {
        name   = "virtualization-type"
        values = ["{{ bastion_host_ami_virtualization_type }}"]
    }
  }

  resource "aws_launch_template" "bastion_host_launch_template" {
    name_prefix             = "${ var.project_name }-${ var.environment }-bastion"
    description             = "bastion_host_launch_template"
    disable_api_termination = "false"
    image_id                = data.aws_ami.bastion_host_ami.id
    instance_type           = "{{ bastion_instance_type }}"
    key_name                = "${var.ssh_key_name}"
    # vpc_security_group_ids  = [var.default_security_group_id]
  }

  resource "aws_instance" "bastion_host" {
    count = {{ bastion_instance_count }}
    launch_template {
      id = aws_launch_template.bastion_host_launch_template.id
      version = "$Latest"
    }

    associate_public_ip_address = true

    subnet_id = var.vpc_public_subnets
    vpc_security_group_ids = [var.default_security_group_id]

    tags = {
      Name = "${ var.project_name }-${ var.environment }-bastion"
      Group = "bastion"
      Project = "${ var.project_name }-${ var.environment }"
      environment = var.environment
      terraform = "true"
    }
  }

  output "k8s_bastion_ips" {
    value = [for host in aws_instance.bastion_host:
      host.public_ip
    ]
  }
